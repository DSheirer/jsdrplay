# Pinned SDRplay API for jsdrplay. Sourced by the scripts in native/ and read
# by build.gradle.kts and the GitHub workflows. To move to a new API release,
# change these values and open a pull request.
#
# The SDRplay API is closed source and its licence does not allow
# redistribution, so jsdrplay never ships it. The build downloads the official
# Linux installer only to read its C headers: CI checks the Java bindings
# against them on every platform. Nothing from the installer is executed or
# packaged.
#
# SDRPLAY_API_VERSION must equal SDRPLAY_API_VERSION in sdrplay_api.h from the
# installer, which the build checks. It is also the start of the jsdrplay
# version: jsdrplay 3.15.x targets API 3.15.
SDRPLAY_API_VERSION=3.15
SDRPLAY_INSTALLER_URL=https://www.sdrplay.com/software/SDRplay_RSP_API-Linux-3.15.2.run
SDRPLAY_INSTALLER_SHA256=3a97ca764263bbe76fb0f2220e6408942357e8864c19e1408a6d6987af382fe3
